# ─────────────────────────────────────────────────────────────
# Scout — environment
#
# All of these are OPTIONAL. Without any of them the app still runs:
# the live opportunity feed, admissions, search, filtering, the dossier
# and the whole dashboard are keyless. Only the AI features need a key.
#
# Local dev:  copy to .env.local — scripts/dev.mjs loads it automatically.
# Vercel:     vercel env add <NAME> production
# ─────────────────────────────────────────────────────────────

# The LLM provider chain in api/_lib/llm.js tries these in order and uses
# the first that answers. One is enough.

# OpenAI-compatible endpoint. Groq by default; any compatible base works.
# Powers drafting, rewrites, the agent, NL search, and document reading.
OPENAI_COMPAT_KEY=
# OPENAI_COMPAT_BASE=https://api.groq.com/openai/v1

# Optional alternates — tried before/after the above, see api/_lib/llm.js
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
